rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // O VeriFLY acessa o banco pelo Admin SDK no Flask e no worker.
    // Esses processos usam IAM; clientes web/mobile nao acessam diretamente.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
